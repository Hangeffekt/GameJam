[node name="PLACEHOLDERNAMEDialogueManager" parent="." unique_id=562795217 instance=ExtResource("5_y6sft")]
visible = false
text_key = Array[String](["**TEST**Szeretném, ha most megosztanál velem egy jóslást, ami a következő időszakomra vonatkozik. Bízom a megérzéseidben és a látásmódodban, ezért kíváncsi vagyok, mit jósolsz nekem. Kérlek, fogalmazz meg egy konkrét, inspiráló jóslatot, ami útmutatást adhat a döntéseimhez. Ha van valamilyen szimbolikus kép vagy érzés, ami eszedbe jut rólam, azt is szívesen fogadom. Előre is köszönöm a segítségedet és a rám szánt idődet!"])
