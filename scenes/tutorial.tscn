[node name="SartTutorial" parent="." unique_id=515192348 instance=ExtResource("3_4kmhl")]
text_key = Array[String](["ÁÁÁÁ, úgy látom keresl valamit. Jóhelyen jársz.", "Válassz a fenti menük közül és mindere választ kapsz!"])
