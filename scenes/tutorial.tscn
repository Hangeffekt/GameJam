[node name="MainTutorial" parent="." unique_id=1700445730 instance=ExtResource("3_4kmhl")]
text_key = Array[String](["Az első nap mindíg nehéz nem igaz. Ne aggódj segítek eligazodni a sok őjdonségban.", "Egyátlagos nap kinyitod a boltot. Jönnek a vásárlók akik szeretnének valami... hogy is mondjam?", "Nem éppen jóra való dolgot... Béjitalt, csillagok olvasását, vagy Jóslást kártyából.", "Hakész, fizetnek és jön a következő, közben minden féle dologgal traktálnak."])
characters_name = Array[String](["Wizz Ard", "Wizz Ard", "Wizz Ard", "Wizz Ard"])
textcolor = Array[Color]([Color(0, 0, 0, 1), Color(0, 0, 0, 1), Color(0, 0, 0, 1), Color(0, 0, 0, 1)])
Portraits = Array[Texture2D]([ExtResource("4_cq4me"), ExtResource("6_gbqnl"), ExtResource("7_ckvwl"), ExtResource("4_cq4me")])

