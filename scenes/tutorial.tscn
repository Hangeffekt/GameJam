[node name="SartTutorial" parent="." unique_id=515192348 instance=ExtResource("3_4kmhl")]
visible = false
text_key = Array[String](["ÁÁÁÁ, úgy látom, keresel valamit! Jó helyen jársz!", "Ha még egyszer rám kattintasz a sarokban nem foglak zavarni.", "Válassz a bal oldali gombok közül, és minden kérdésedre választ kapsz!"])
characters_name = Array[String](["Wizz Ard", "Wizz Ard", "Wizz Ard"])
textcolor = Array[Color]([Color(1, 1, 1, 1), Color(1, 1, 1, 1), Color(1, 1, 1, 1)])
Portraits = Array[Texture2D]([ExtResource("4_cq4me"), ExtResource("6_gbqnl"), ExtResource("5_6yjpi")])

[node name="MainTutorial" parent="." unique_id=1700445730 instance=ExtResource("3_4kmhl")]
visible = false
text_key = Array[String](["Az első nap mindig nehéz, nem igaz? Ne aggódj, segítek eligazodni a sok újdonság között.", "Egy átlagos nap: kinyitod a boltot, és máris érkeznek a vásárlók, akik valami… hogy is mondjam?", "Nem éppen tisztességes dologra vágynak. Bájitalokra, csillagjóslásra vagy éppen kártyavetésre.", "Ha végeztek, fizetnek, majd jön a következő vásárló. Közben pedig mindenféle történettel traktálnak."])
characters_name = Array[String](["Wizz Ard", "Wizz Ard", "Wizz Ard", "Wizz Ard"])
textcolor = Array[Color]([Color(1, 1, 1, 1), Color(1, 1, 1, 1), Color(1, 1, 1, 1), Color(1, 1, 1, 1)])
Portraits = Array[Texture2D]([ExtResource("4_cq4me"), ExtResource("6_gbqnl"), ExtResource("7_ckvwl"), ExtResource("4_cq4me")])

[node name="PotionTutorial" parent="." unique_id=1044000698 instance=ExtResource("3_4kmhl")]
visible = false
text_key = Array[String](["A bájitalkeverés nem könnyű mesterség. Minden tudásodra szükséged lesz ahhoz, hogy a főzet kiváló legyen.", "Nézd meg a bal oldalon található receptet! Három sorban három különböző értéket találsz.", "Most pillants a jobb oldalra! Itt kategóriákba rendezve találod az összetevőket. Mindegyik összetevő három különböző értékkel rendelkezik.", "Ha kiválasztasz egy összetevőt, az bekerül a mozsárba. Minden bájital elkészítéséhez három összetevőre van szükséged, de mindegyiket csak egyszer választhatod ki. Szerencsére az utoljára hozzáadott összetevőt még eltávolíthatod.", "Alul láthatod, hogyan alakul az egyes módosítók összértéke a kiválasztott összetevők alapján.", "Ha úgy gondolod, minden a helyére került, nyomd meg az Őrlés és főzés gombot, hogy elkészítsd a bájitalt!"])
characters_name = Array[String](["Wizz Ard", "Wizz Ard", "Wizz Ard", "Wizz Ard", "Wizz Ard", "Wizz Ard"])
textcolor = Array[Color]([Color(1, 1, 1, 1), Color(1, 1, 1, 1), Color(1, 1, 1, 1), Color(1, 1, 1, 1), Color(1, 1, 1, 1), Color(1, 1, 1, 1)])
Portraits = Array[Texture2D]([ExtResource("4_cq4me"), SubResource("CompressedTexture2D_ckvwl"), SubResource("CompressedTexture2D_nlqja"), ExtResource("4_cq4me"), ExtResource("4_cq4me"), ExtResource("4_cq4me")])

[node name="MoonPlateTutorial" parent="." unique_id=1939476836 instance=ExtResource("3_4kmhl")]
visible = false
text_key = Array[String](["A Holdtál mélyén csillagok tükröződnek, vizük a jövő titkait őrzi.", "Egyetlen csepp hullik a tükörsima felszínre, s a víz fodrozódni kezd.", "Figyeld a megfelelő pillanatot! Ha jókor kongatod meg a tálat, az egyik csillag felragyog.", "Hívd életre az összes csillagot, és feltárulnak előtted a jövő titkai. Ha mind felragyogott, a csillagolvasás sikeres!"])
characters_name = Array[String](["Wizz Ard", "Wizz Ard", "Wizz Ard", "Wizz Ard"])
textcolor = Array[Color]([Color(1, 1, 1, 1), Color(0.9691369, 0.9691369, 0.9691368, 1), Color(0.9955804, 0.99558026, 0.99558026, 1), Color(0.9955804, 0.99558026, 0.99558026, 1)])
Portraits = Array[Texture2D]([ExtResource("4_cq4me"), ExtResource("6_gbqnl"), ExtResource("7_ckvwl"), ExtResource("4_cq4me")])

[node name="TarrotTutorial" parent="." unique_id=1791220221 instance=ExtResource("3_4kmhl")]
visible = false
text_key = Array[String](["Az első nap mindíg nehéz nem igaz. Ne aggódj segítek eligazodni a sok őjdonségban.", "Egyátlagos nap kinyitod a boltot. Jönnek a vásárlók akik szeretnének valami... hogy is mondjam?", "Nem éppen jóra való dolgot... Béjitalt, csillagok olvasását, vagy Jóslást kártyából.", "Hakész, fizetnek és jön a következő, közben minden féle dologgal traktálnak."])
characters_name = Array[String](["Wizz Ard", "Wizz Ard", "Wizz Ard", "Wizz Ard"])
textcolor = Array[Color]([Color(1, 1, 1, 1), Color(0.9955804, 0.99558026, 0.99558026, 1), Color(1, 1, 1, 1), Color(1, 1, 1, 1)])
Portraits = Array[Texture2D]([ExtResource("4_cq4me"), ExtResource("6_gbqnl"), ExtResource("7_ckvwl"), ExtResource("4_cq4me")])

[node name="StillHere" parent="." unique_id=1676930901 instance=ExtResource("3_4kmhl")]
visible = false
text_key = Array[String](["Nahát, még nem sikerült mindent kiderítened? Sebaj, nem szaladnak el a titkok!", "Válassz a bal oldali gombok közül és mindere választ kapsz!"])
characters_name = Array[String](["Wizz Ard", "Wizz Ard"])
textcolor = Array[Color]([Color(1, 1, 1, 1), Color(1, 1, 1, 1)])
Portraits = Array[Texture2D]([ExtResource("4_cq4me"), ExtResource("5_6yjpi")])

